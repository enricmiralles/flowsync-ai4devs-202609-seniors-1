{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd frontend && npx prettier --write . 2>$null || $true",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
